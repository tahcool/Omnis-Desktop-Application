# ──────────────────────────────────────────────────
# Omnis Desktop — Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.
#
# Get the anon/public key from:
#   Supabase Dashboard → Settings → API → Project API keys
#
# The service role key must NEVER appear in this file
# or anywhere in the Electron client code.
# ──────────────────────────────────────────────────

# Required — Supabase publishable (anon) key
SUPABASE_ANON_KEY=eyJ...your-anon-key-here

# Optional — override default project URL
# SUPABASE_URL=https://pfqaeewmlwfayxbgmuaq.supabase.co
