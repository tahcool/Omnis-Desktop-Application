n          </tr>\n        </table>\n        <table style=\"border-collapse: separate\">\n          <tr>\n            <td class=\"text-black font-bold px-2 text-nowrap\">{{ doc.name }}</td>\n\n            <td class=\"text-sm px-1 text-xxs\">\n              fleetrack@machinery-exchange.com | https://fleetrack.machinery-exchange.com | +263 784 488 801\n            </td>\n          </tr>\n        </table>\n      </div>\n    </div>\n\n    <table class=\"text-sm mt-3 mb-3\">\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Printed by</td>\n        <td style=\"padding: 2px 3px !important\">\n          {{ frappe.db.get_value(\"User\",{\"name\":frappe.session.user}, \"full_name\") }}\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Date</td>\n        <td style=\"padding: 2px 3px !important\">{{ frappe.utils.today() }}</td>\n      </tr>\n    </table>\n\n    <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n      <thead>\n        <tr>\n          <th class=\"bg-ft-red border text-xl border-ft-red text-white uppercase font-bold text-center\" colspan=\"8\">\n            SB Details\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td style=\"padding: 2px 5px !important\" colspan=\"4\" class=\"tiny-td-padding\"></td>\n        </tr>\n        <tr>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-mxg-alt border border-mxg-alt text-white\">\n            Issued By\n          </th>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding text-center border border-mxg-alt\">\n            {{ doc.issued_by }}\n          </td>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-mxg-alt border border-mxg-alt text-white\">\n            Date Issued\n          </th>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding border text-center border-mxg-alt\">\n            {{ doc.get_formatted(\"date_issued\", doc) }}\n          </td>\n        </tr>\n        <tr>\n          <td colspan=\"4\" style=\"padding: 2px 10px !important\" class=\"tiny-td-padding text-left\">\n            <span class=\"text-ft-red font-bold\">OEM:</span>\n            <span class=\"text-black\">{{ doc.oem }}</span>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n\n    <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n      <thead>\n        <tr>\n          <th\n            style=\"width: 70%\"\n            class=\"bg-ft-red border text-lg border-ft-red text-white font-bold text-center\"\n            colspan=\"\">\n            Models Applicable\n          </th>\n          <th\n            style=\"width: 30%\"\n            class=\"bg-ft-red border text-lg border-ft-red text-white font-bold text-center\"\n            colspan=\"\">\n            Other\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td style=\"padding: 2px 5px !important\" colspan=\"\" class=\"tiny-td-padding border border-ft-red\">\n            {% if doc.models_applicable %}\n            <ul style=\"column-count: 4\">\n              {% for item in doc.models_applicable %}\n              <li>{{ item.model }}</li>\n              {% endfor %}\n            </ul>\n            {% else %}\n            <span class=\"\">No models applicable</span>\n            {% endif %}\n          </td>\n          <td style=\"padding: 2px 5px !important\" colspan=\"\" class=\"tiny-td-padding border border-ft-red\">\n            {% if doc.types_applicable %}\n            <ul style=\"column-count: 3\">\n              {% for item in doc.types_applicable %}\n              <li>{{ item.type }}</li>\n              {% endfor %}\n            </ul>\n            {% else %}\n            <span class=\"\">Not applicable</span>\n            {% endif %}\n          </td>\n        </tr>\n      </tbody>\n    </table>\n\n    <table class=\"w-full mt-1 mb-1\">\n      <tbody>\n        <tr>\n          <td class=\"tiny-td-padding uppercase text-nowrap bg-ft-red font-bold text-lg text-center\">Subject</td>\n        </tr>\n        <tr>\n          <td class=\"tiny-td-padding font-bold px-0\">{{ doc.subject }}</td>\n        </tr>\n        <tr>\n          <td class=\"tiny-td-padding uppercase text-nowrap bg-ft-red font-bold text-lg text-center\">Outline</td>\n        </tr>\n        <tr>\n          <td class=\"tiny-td-padding px-0 pb-10\">\n            <span class=\"font-bold\">This service bulletin is to inform you that:</span>\n            <span>{{ doc.outline }}</span>\n          </td>\n        </tr>\n        <tr>\n          <td class=\"tiny-td-padding uppercase text-nowrap bg-mxg-alt font-bold text-lg text-center\">\n            Implementation Procedure and Items\n          </td>\n        </tr>\n        <tr>\n          <td class=\"tiny-td-padding px-0 pb-10\">\n            <i>{{ doc.implementation_procedure|default(\"\", True) }}</i>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n    <div>\n      <!-- Photgraphic details -->\n      {% set images = frappe.db.get_all(\"FT Image Gallery\", filters={\"reference_doctype\": doc.doctype, \"reference_name\":\n      doc.name}, fields=[\"caption\", \"image\"]) %} {% if images %}\n      <table class=\"w-full\">\n        <thead>\n          <tr>\n            <th colspan=\"4\" class=\"text-center border border-ft-red bg-ft-red text-white uppercase\">\n              Photographic Illustration\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            {% for item in images %}\n            <td class=\"text-nowrap\" style=\"padding: 0 !important\">\n              <div class=\"flex flex-col border border-mxg-alt\">\n                <div class=\"w-auto bg-mxg-alt text-white py-1 px-4 text-center\">{{ item.caption }}</div>\n                <div style=\"height: 11rem\" class=\"w-full py-1\">\n                  <img src=\"{{ item.image }}\" style=\"height: 100%; object-fit: contain\" class=\"w-full\" alt=\"\" />\n                </div>\n              </div>\n            </td>\n            {% if loop.index%4 == 0 %}\n          </tr>\n          <tr>{% endif %} {% endfor %}</tr>\n        </tbody>\n      </table>\n      {% endif %}\n\n      <!-- Signatures -->\n      <table class=\"w-full mt-4\">\n        <thead>\n          <tr>\n            <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n              Fleetrack\n            </th>\n            <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n              Customer Service Coordinator\n            </th>\n            <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n              CSD Manager\n            </th>\n            <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n              SRD Manager\n            </th>\n            <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n              Managing Director\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td class=\"border border-ft-red pt-5\">&nbsp;</td>\n            <td class=\"border border-ft-red pt-5\"></td>\n            <td class=\"border border-ft-red pt-5\"></td>\n            <td class=\"border border-ft-red pt-5\"></td>\n            <td class=\"border border-ft-red pt-5\"></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </body>\n</html>\n",
