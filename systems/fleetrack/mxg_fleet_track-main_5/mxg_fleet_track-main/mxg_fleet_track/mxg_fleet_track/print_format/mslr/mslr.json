e Service Life Report (MSLR)</h1>\n            </th>\n          </tr>\n        </thead>\n        <tr>\n          <th style=\"padding: 0 0 5px 0 !important\" colspan=\"6\" class=\"text-right px-0\">\n            <h1 style=\"color: #a3a4a5\" class=\"text-2xl text-mxg-alt font-bold my-0 m-0 p-0\">{{ machine.model }}</h1>\n            <div class=\"flex items-center justify-end gap-1\">\n              <h5 style=\"color: #a3a4a5\" class=\"text-base text-mxg-alt font-bold my-0 m-0 p-0\">{{ machine.type }}</h5>\n            </div>\n          </th>\n        </tr>\n        <tr>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 text-xs font-bold text-nowrap\">Machine SRN</td>\n          <td class=\"px-2 tiny-td-padding border border-black uppercase text-xs font-bold text-nowrap\">{{ doc.sn }}</td>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 text-xs font-bold text-nowrap\">\n            Customer Ref\n          </td>\n          <td class=\"tiny-td-padding border border-black px-1 text-xs font-bold text-nowrap\">{{ machine.fleet_no }}</td>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red py-1 px-4 text-center text-xs text-nowrap\">\n            <div class=\"flex flex-col\">\n              <span class=\"text-white\">Fleet No</span>\n            </div>\n          </td>\n          <td class=\"tiny-td-padding border border-black px-1 text-xs font-bold text-nowrap\">\n            {{ machine.mxg_fleet_no|default(\"&nbsp;\", True) }}\n          </td>\n        </tr>\n        <tr>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 py-0 text-xs font-bold text-nowrap\">\n            Engine Make\n          </td>\n          <td class=\"px-2 border tiny-td-padding border-black uppercase text-xs font-bold text-nowrap\">\n            {{ machine.engine_type }}\n          </td>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 text-xs font-bold text-nowrap\">Engine SRN</td>\n          <td colspan=\"3\" class=\"tiny-td-padding border border-black px-1 text-xs font-bold text-nowrap\">\n            {{ machine.esn }}\n          </td>\n        </tr>\n        <tr>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 py-0 text-xs font-bold text-nowrap\">\n            Current HMR\n          </td>\n          <td class=\"px-2 border tiny-td-padding border-black uppercase text-xs font-bold text-nowrap\">\n            {{ machine.current_hmr }}\n          </td>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 text-xs font-bold text-nowrap\">\n            Total Running Hours\n          </td>\n          <td colspan=\"3\" class=\"tiny-td-padding border border-black px-1 text-xs font-bold text-nowrap\">\n            {{ machine.total_running_hours }}\n          </td>\n        </tr>\n        <tr>\n          <td class=\"bg-mxg-alt tiny-td-padding border border-ft-red px-2 py-0 text-xs font-bold text-nowrap\">\n            Handover Date\n          </td>\n          <td class=\"px-2 border tiny-td-padding border-black text-xs font-bold text-nowrap\">\n            {{ frappe.format_date(machine.handover_date) }}\n          </td>\n          <td class=\"bg-mxg-alt tiny-td-padding border border-ft-red px-2 text-xs font-bold text-nowrap\">\n            Warranty Expiry Date\n          </td>\n          <td colspan=\"3\" class=\"tiny-td-padding border border-black px-1 text-xs font-bold\">\n            {{frappe.format_date(machine.expiry_date)}}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"padding: 0 !important\" colspan=\"6\" class=\"text-sm px-1 text-xxs text-right\">\n            fleetrack@machinery-exchange.com | https://fleetrack.machinery-exchange.com | +263 784 488 801\n          </td>\n        </tr>\n      </table>\n    </div>\n    <table style=\"border-collapse: separate\">\n      <tr>\n        <th colspan=\"6\" class=\"text-left\" style=\"padding: 0 !important\">\n          <h1 style=\"padding-right: 5px\" class=\"text-xl flex items-center font-bold text-black my-0\">\n            <svg\n              width=\"24px\"\n              height=\"24px\"\n              viewBox=\"0 0 24 24\"\n              stroke-width=\"2\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              color=\"#000000\">\n              <path\n                d=\"M12 12a4 4 0 100-8 4 4 0 000 8z\"\n                stroke=\"#000000\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"></path>\n              <path\n                d=\"M5 20v-1a7 7 0 0110-6.326M21 22l1-6-3.5 1.8L17 16l-1.5 1.8L12 16l1 6h8z\"\n                stroke=\"#000000\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"></path>\n            </svg>\n            <span class=\"pl-2\">{{ doc.customer }}</span>\n          </h1>\n        </th>\n      </tr>\n    </table>\n    <table class=\"text-sm mt-3\">\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Printed by</td>\n        <td style=\"padding: 2px 3px !important\">\n          {{ frappe.db.get_value(\"User\",{\"name\":frappe.session.user}, \"full_name\") }}\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Date</td>\n        <td style=\"padding: 2px 3px !important\">{{ frappe.utils.today() }}</td>\n      </tr>\n    </table>\n\n    <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n      <thead>\n        <tr>\n          <th\n            style=\"padding: 2px 3px !important\"\n            class=\"bg-ft-red border border-ft-red text-white uppercase font-black text-center\"\n            colspan=\"2\">\n            Ownership Costs (Operational)\n          </th>\n        </tr>\n      </thead>\n      {% set fuel_consumed = (doc.standard_fuel_consumption or 0) * doc.total_running_hours %}\n      <tbody>\n        <tr>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding\">\n            <span class=\"text-sm\">\n              Fuel Consumed to date ~\n              <span class=\"text-ft-red\">{{ fuel_consumed }}L</span>\n            </span>\n          </td>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding text-left\">\n            <i class=\"text-ft-red\">*Limited to jobs carried out by Machinery Exchange</i>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n    <!-- prettier-ignore -->\n    {% set repairs_value_total = frappe.db.sql(\"SELECT sum(value) as value FROM `tabFT JRV` WHERE machine='%s' AND nature in (%s)\" % (machine.name, \"'Defects', 'Breakdown'\"), as_dict=1)[0] %}\n    <!-- prettier-ignore -->\n    {% set maintenance_value_total = frappe.db.sql(\"SELECT sum(value) as value FROM `tabFT JRV` WHERE machine='%s' AND nature in (%s)\" % (machine.name, \"'Service', 'Service + Defect'\"), as_dict=1)[0] %}\n    <!-- prettier-ignore -->\n    {% set mods_value_total = frappe.db.sql(\"SELECT sum(value) as value FROM `tabFT JRV` WHERE machine='%s' AND nature in (%s)\" % (machine.name, \"'Modification', 'Other'\"), as_dict=1)[0] %}\n    <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n      <thead>\n        <tr>\n          <th\n            style=\"padding: 2px 3px !important\"\n            class=\"bg-mxg-alt text-nowrap border border-mxg-alt text-white uppercase font-black text-left\">\n            Repairs to date (USD)\n            <span class=\"text-sm text-white\">\n              ~\n              <span class=\"font-black text-white\">\n                {{ frappe.utils.fmt_money(repairs_value_total.value,currency=\"$\") }}\n              </span>\n            </span>\n          </th>\n          <th\n            style=\"padding: 2px 3px !important\"\n            class=\"bg-mxg-alt border text-nowrap uppercase border-mxg-alt text-white font-black text-left\">\n            Periodic Maint.\n            <br />\n            <span class=\"text-sm text-white\">\n              (Service) to Date (USD) ~\n              <span class=\"font-black text-white\">\n                {{ frappe.utils.fmt_money(maintenance_value_total.value, currency=\"$\") }}\n              </span>\n            </span>\n          </th>\n          <th\n            style=\"padding: 2px 3px !important\"\n            class=\"bg-mxg-alt border text-nowrap border-mxg-alt text-white uppercase font-black text-left\">\n            Modifications & Misc\n            <span class=\"text-sm text-white\">\n              ~\n              <span class=\"font-black text-white\">\n                {{ frappe.utils.fmt_money(mods_value_total.value, currency=\"$\") }}\n              </span>\n            </span>\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"border-right tiny-td-padding border-mxg-alt\">\n            <ol type=\"1\">\n              <!-- prettier-ignore -->\n              {% set repair_jobs = frappe.get_all(\"FT JRV\", filters={\"machine\": doc.name, \"workflow_state\": \"Complete\", \"nature\": [\"in\", (\"Defects\", \"Breakdown\")]}, fields=[\"name\", \"job_no\", \"date\"]) %}\n              <!-- prettier-ignore -->\n              {% for job in repair_jobs %}\n              <!-- prettier-ignore -->\n              {% set desc_items = frappe.get_all(\"FT JRV Details\", filters={\"parent\": job.name }, pluck=\"basic_description\") %}\n              <li>\n                <span class=\"font-bold\">{{ job.job_no }}</span>\n                {% if desc_items %} ~ {{ desc_items[0] }} {% endif %} ~ {{ job.date }}\n              </li>\n              {% endfor %}\n            </ol>\n          </td>\n          <td class=\"tiny-td-padding text-left\">\n            <ol type=\"1\">\n              <!-- prettier-ignore -->\n              {% set periodic_maint_jobs = frappe.get_all(\"FT JRV\", filters={\"machine\": doc.name, \"workflow_state\": \"Complete\", \"nature\": [\"in\", (\"Service\", \"Service + Defect\")]}, fields=[\"name\", \"job_no\", \"date\"]) %}\n              <!-- prettier-ignore -->\n              {% for job in periodic_maint_jobs %}\n              <!-- prettier-ignore -->\n              {% set desc_items = frappe.get_all(\"FT JRV Details\", filters={ \"parent\": job.name}, pluck=\"basic_description\") %}\n              <li>\n                <span class=\"font-bold\">{{ job.job_no }}</span>\n                {% if desc_items %} ~ {{ desc_items[0]}} {% endif %} ~ {{ job.date }}\n              </li>\n              {% endfor %}\n            </ol>\n          </td>\n          <td class=\"tiny-td-padding text-left\">\n            <ol type=\"1\">\n              <!-- prettier-ignore -->\n              {% set modification_jobs = frappe.get_all(\"FT JRV\", filters={\"machine\": doc.name, \"workflow_state\": \"Complete\", \"nature\": [\"in\", (\"Modification\", \"Other\")]}, fields=[\"name\", \"job_no\", \"date\"]) %}\n              <!-- prettier-ignore -->\n              {% for job in modification_jobs %}\n              <!-- prettier-ignore -->\n              {% set desc_items = frappe.get_all(\"FT JRV Details\", filters={ \"parent\": job.name }, pluck=\"basic_description\") %}\n              <li>\n                <span class=\"font-bold\">{{ job.job_no }}</span>\n                {% if desc_items %} ~ {{ desc_items[0]}} {% endif %} ~ {{ job.date }}\n              </li>\n              {% endfor %}\n            </ol>\n          </td>\n        </tr>\n      </tbody>\n      <tfoot>\n        <tr>\n          <th\n            style=\"padding: 2px 3px !important\"\n            colspan=\"3\"\n            class=\"tiny-td-padding text-sm text-center bg-ft-red border-bottom border-4 border-ft-red font-black\">\n            Events & History\n          </th>\n        </tr>\n        <tr>\n          <th\n            style=\"padding: 2px 3px !important\"\n            colspan=\"2\"\n            class=\"tiny-td-padding text-sm text-left bg-mxg-alt border-bottom border-4 border-mxg-alt font-black\">\n            Warranty Cases Raised\n          </th>\n          <th\n            style=\"padding: 2px 3px !important\"\n            class=\"tiny-td-padding text-left bg-mxg-alt border-bottom text-sm font-black border-4 border-mxg-alt\">\n            Maintenance Warnings Issued\n          </th>\n        </tr>\n        <tr>\n          <td colspan=\"2\" class=\"tiny-td-padding text-left\">\n            <!-- prettier-ignore -->\n            {% set warranty_cases = frappe.get_all(\"FT Warranty Claim\", filters={\"machine_srn\": doc.name}, fields=[\"date\", \"description\", \"job_no\"]) %}\n            <ul type=\"1\">\n              {% for case in warranty_cases %}\n              <li>\n                <span class=\"font-bold\">{{ case.description }}</span>\n                ~ {{ case.job_no|default(\"\", True) }}\n              </li>\n              {% endfor %}\n            </ul>\n          </td>\n          <td class=\"tiny-td-padding text-left\">\n            <!-- prettier-ignore -->\n            {% set maint_warnings_single = frappe.get_all(\"FT Maintenance Warning Report\", filters={\"mwr_mode\": \"Single Machine\", \"machine\": doc.name}, fields=[\"name\", \"date_of_issue\", \"warranty_violation\", \"overdue_maintenance\", \"major_defects\", \"advisory\", \"other\"]) %}\n            <ul type=\"1\">\n              {% for warning in maint_warnings_single %}\n              <li>\n                <span class=\"font-bold\">{{ warning.name }}</span>\n                ~ {% if warning.overdue_maintenance %}\n                <span class=\"text-ft-red\">Overdue Maintenance</span>\n                {% endif %} {% if warning.warranty_violation %}\n                <span class=\"text-ft-red\">Warranty Violation</span>\n                {% endif %} {% if warning.major_defects %}\n                <span class=\"text-ft-red\">Major Defects</span>\n                {% endif %} {% if warning.advisory %}\n                <span class=\"text-ft-red\">Advisory</span>\n                {% endif %} {% if warning.other %}\n                <span class=\"text-ft-red\">Other</span>\n                {% endif %} ~ {{ warning.date_of_issue }}\n              </li>\n              {% endfor %}\n            </ul>\n          </td>\n        </tr>\n        <tr>\n          <th\n            style=\"padding: 2px 3px !important\"\n            colspan=\"3\"\n            class=\"tiny-td-padding bg-ft-red text-sm uppercase border-right font-black border-white border-4\">\n            Current State\n          </th>\n        </tr>\n        <tr>\n          <td style=\"padding: 0 !important\" colspan=\"3\">&nbsp;</td>\n        </tr>\n        <tr>\n          <th colspan=\"1\" class=\"tiny-td-padding bg-mxg-alt text-left border-right border-white border-4\">\n            Active Defects & BD\n          </th>\n          <th colspan=\"1\" class=\"tiny-td-padding bg-mxg-alt text-left border-right border-white border-4\">\n            Maint. Status\n          </th>\n          <th colspan=\"1\" class=\"tiny-td-padding bg-mxg-alt text-left border-right border-white border-4\">\n            Other Comments\n          </th>\n        </tr>\n        <tr>\n          <td style=\"font-style: italic !important\" class=\"tiny-td-padding\">\n            <!-- prettier-ignore -->\n            {% set defects = frappe.get_all(\"FT Defects Log\", filters={ \"machine\": doc.name, \"end_date\": [\"is\", \"not set\"], }, fields=[\"description\", \"status\"]) %}\n            <!-- prettier-ignore -->\n            {% set breakdowns = frappe.get_all(\"FT Breakdown Log\", filters={ \"machine\": doc.name, \"end_date\": [\"is\", \"not set\"], }, fields=[\"description\", \"status\"]) %}\n            <ul type=\"1\">\n              {% for defect in defects %}\n              <li>\n                <span class=\"font-bold\">{{ defect.description }}</span>\n                ~ {{ defect.status }}\n              </li>\n              {% endfor %} {% for breakdown in breakdowns %}\n              <li>\n                <span class=\"font-bold\">{{ breakdown.description }}</span>\n                ~ {{ breakdown.status }}\n              </li>\n              {% endfor %}\n            </ul>\n          </td>\n          <td style=\"font-style: italic !important\" class=\"tiny-td-padding\">\n            <dl>\n              <dt>HRS to Service</dt>\n              <dd>{{ doc.hours_remaining_to_service|default(\"\", True) }}</dd>\n              <dt>Last Service Date</dt>\n              <dd>{{ doc.get_formatted(\"last_service_date\", doc)|default(\"-\", True) }}</dd>\n              <dt>Next Service Type (HR)</dt>\n              <dd>{{ doc.get_formatted(\"next_service_type\", doc) }}</dd>\n            </dl>\n          </td>\n          <td style=\"font-style: italic !important\" class=\"tiny-td-padding\">{{ doc.notes|default(\"\", True) }}</td>\n        </tr>\n      </tfoot>\n    </table>\n\n    <!-- Signatures -->\n    <table class=\"w-full mt-4\">\n      <thead>\n        <tr>\n          <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n            Fleetrack\n          </th>\n          <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n            Customer Service Coordinator\n          </th>\n          <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n            CSD Manager\n          </th>\n          <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n            SRD Manager\n          </th>\n          <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n            Managing Director\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"border border-ft-red pt-5\">&nbsp;</td>\n          <td class=\"border border-ft-red pt-5\"></td>\n          <td class=\"border border-ft-red pt-5\"></td>\n          <td class=\"border border-ft-red pt-5\"></td>\n          <td class=\"border border-ft-red pt-5\"></td>\n        </tr>\n      </tbody>\n    </table>\n  </body>\n</html>\n",
