t-right px-0\">\n            <h1 style=\"color: #a3a4a5\" class=\"text-2xl text-mxg-alt font-bold my-0 m-0 p-0\">{{ machine.model }}</h1>\n            <div class=\"flex items-center justify-end gap-1\">\n              <h5 style=\"color: #a3a4a5\" class=\"text-base text-mxg-alt font-bold my-0 m-0 p-0\">{{ machine.type }}</h5>\n            </div>\n          </th>\n        </tr>\n        <tr>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 text-xs font-bold text-nowrap\">Machine SRN</td>\n          <td class=\"px-2 tiny-td-padding border border-black uppercase text-xs font-bold text-nowrap\">\n            {{ machine.sn }}\n          </td>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 text-xs font-bold text-nowrap\">\n            Customer Ref\n          </td>\n          <td class=\"tiny-td-padding border border-black px-1 text-xs font-bold text-nowrap\">{{ machine.fleet_no }}</td>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red py-1 px-4 text-center text-xs text-nowrap\">\n            <div class=\"flex flex-col\">\n              <span class=\"text-white\">Fleet No</span>\n            </div>\n          </td>\n          <td class=\"tiny-td-padding border border-black px-1 text-xs font-bold text-nowrap\">\n            {{ machine.mxg_fleet_no|default(\"&nbsp;\", True) }}\n          </td>\n        </tr>\n        <tr>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 py-0 text-xs font-bold text-nowrap\">\n            Engine Make\n          </td>\n          <td class=\"px-2 border tiny-td-padding border-black uppercase text-xs font-bold text-nowrap\">\n            {{ machine.engine_type }}\n          </td>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 text-xs font-bold text-nowrap\">Engine SRN</td>\n          <td colspan=\"3\" class=\"tiny-td-padding border border-black px-1 text-xs font-bold text-nowrap\">\n            {{ machine.esn }}\n          </td>\n        </tr>\n        <tr>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 py-0 text-xs font-bold text-nowrap\">\n            Current HMR\n          </td>\n          <td class=\"px-2 border tiny-td-padding border-black uppercase text-xs font-bold text-nowrap\">\n            {{ machine.current_hmr }}\n          </td>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 text-xs font-bold text-nowrap\">\n            Total Running Hours\n          </td>\n          <td colspan=\"3\" class=\"tiny-td-padding border border-black px-1 text-xs font-bold text-nowrap\">\n            {{ machine.total_running_hours }}\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding: 0 !important\" colspan=\"6\" class=\"text-sm px-1 text-xxs text-right\">\n            fleetrack@machinery-exchange.com | https://fleetrack.machinery-exchange.com | +263 784 488 801\n          </td>\n        </tr>\n      </table>\n    </div>\n    <table class=\"text-sm\">\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Printed by</td>\n        <td style=\"padding: 2px 3px !important\">\n          {{ frappe.db.get_value(\"User\",{\"name\":frappe.session.user}, \"full_name\") }}\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Date</td>\n        <td style=\"padding: 2px 3px !important\">{{ frappe.utils.today() }}</td>\n      </tr>\n    </table>\n\n    <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n      <thead>\n        <tr>\n          <th class=\"bg-ft-red border border-ft-red text-white uppercase font-bold text-center\" colspan=\"4\">\n            Specific Job Details\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td style=\"padding: 2px 5px !important\" colspan=\"4\" class=\"tiny-td-padding\"></td>\n        </tr>\n        <tr>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-mxg-alt border border-mxg-alt text-white\">\n            Inspecting Technician\n          </th>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding border border-mxg-alt\">\n            {{ doc.inspecting_technician }}\n          </td>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-mxg-alt border border-mxg-alt text-white\">\n            Date of Inspection\n          </th>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding border border-mxg-alt\">\n            {{ doc.date_of_inspection }}\n          </td>\n        </tr>\n        <tr>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-mxg-alt border border-mxg-alt text-white\">\n            Site of Inspection\n          </th>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding border border-mxg-alt\">\n            {{ doc.site_of_inspection }}\n          </td>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-mxg-alt border border-mxg-alt text-white\">\n            Job No.\n          </th>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding border border-mxg-alt\">\n            {{ doc.job_no|default('', True) }}\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding: 2px 5px !important\" colspan=\"4\" class=\"tiny-td-padding\"></td>\n        </tr>\n      </tbody>\n    </table>\n    <table class=\"w-full\">\n      <thead>\n        <tr>\n          <th colspan=\"6\" class=\"text-center border uppercase font-bold border-ft-red bg-ft-red text-white\">\n            Inspection Checklist\n          </th>\n        </tr>\n        <tr>\n          <td style=\"padding: 2px 5px !important\" colspan=\"6\" class=\"tiny-td-padding\"></td>\n        </tr>\n        <tr class=\"text-sm\">\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-ft-red text-white uppercase\">Item</th>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-ft-red text-center text-white uppercase\">\n            <svg\n              width=\"18px\"\n              height=\"18px\"\n              stroke-width=\"2\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              color=\"#fff\">\n              <path\n                d=\"M7 12.5l3 3 7-7\"\n                stroke=\"#fff\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"></path>\n              <path\n                d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"\n                stroke=\"#fff\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"></path>\n            </svg>\n          </th>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding text-left bg-ft-red text-white uppercase\">\n            Comm./Defects/Recom\n          </th>\n        </tr>\n      </thead>\n      <tbody class=\"\" style=\"background-color: #d7d7d7\">\n        <!-- prettier-ignore -->\n        {% set checklist = frappe.db.get_all(\"FT MCA Inspection Checklist\", filters={\"parent\": doc.name}, fields=[\"*\"], order_by=\"item asc\", start=0, page_length=1000) %}\n        {% for item in checklist %}\n        <tr>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding text-left\">{{ item.item }}</td>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding text-center\">\n            {% if item.status %}\n            <svg\n              width=\"18px\"\n              height=\"18px\"\n              stroke-width=\"2\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              color=\"#000\">\n              <path\n                d=\"M7 12.5l3 3 7-7\"\n                stroke=\"#000\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"></path>\n              <path\n                d=\"M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z\"\n                stroke=\"#000\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"></path>\n            </svg>\n            {% endif %}\n          </td>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding text-left\">\n            {{ item.notes|default('', True) }}\n          </td>\n        </tr>\n        {% endfor %}\n      </tbody>\n    </table>\n\n    <div>\n      <!-- Photgraphic details -->\n      {% set images = frappe.db.get_all(\"FT Image Gallery\", filters={\"reference_doctype\": \"FT Machine Condition\n      Assessment\", \"reference_name\": doc.name}, fields=[\"caption\", \"image\"]) %}\n      <table class=\"w-full\">\n        <thead>\n          <tr>\n            <th colspan=\"4\" class=\"text-center border border-ft-red bg-ft-red text-white uppercase\">\n              Photographic Details\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            {% for item in images %}\n            <td class=\"text-nowrap\" style=\"width: 25%\">\n              <div class=\"flex flex-col border border-mxg-alt\">\n                <div class=\"w-full bg-mxg-alt text-white py-1 px-4 text-center\">{{ item.caption }}</div>\n                <div style=\"height: 11rem\" class=\"w-full py-1\">\n                  <!-- <div\n                    style='background-size: cover; background-position: center; background-repeat: no-repeat; background-image: url(\"{{ frappe.utils.get_url() }}{{ item.image }}\");'\n                    class=\"\"\n                  ></div> -->\n                  <img src=\"{{ item.image }}\" style=\"height: 100%; object-fit: contain\" class=\"w-full\" alt=\"\" />\n                </div>\n              </div>\n            </td>\n            {% if loop.index%4 == 0 %}\n          </tr>\n          <tr>{% endif %} {% endfor %}</tr>\n        </tbody>\n      </table>\n\n      <!-- Recommendations -->\n      <table class=\"w-full mt-2\">\n        <thead>\n          <tr>\n            <th\n              style=\"padding: 2px 5px !important\"\n              colspan=\"6\"\n              class=\"text-center border border-ft-red bg-ft-red text-white uppercase\">\n              General Comments/Recommendation\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td colspan=\"6\" class=\"border border-ft-red p-3\">\n              <i>{{ doc.general_comments|default(\"\", True) }}</i>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n      <!-- Signatures -->\n      <table class=\"w-full mt-4\">\n        <thead>\n          <tr>\n            <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n              Fleetrack\n            </th>\n            <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n              Customer Service Coordinator\n            </th>\n            <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n              CSD Manager\n            </th>\n            <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n              SRD Manager\n            </th>\n            <th style=\"padding: 2px 5px !important\" class=\"text-center border border-ft-red bg-ft-red text-white\">\n              Managing Director\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td class=\"border border-ft-red p-3\"></td>\n            <td class=\"border border-ft-red p-3\"></td>\n            <td class=\"border border-ft-red p-3\"></td>\n            <td class=\"border border-ft-red p-3\"></td>\n            <td class=\"border border-ft-red p-3\"></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </body>\n</html>\n",
