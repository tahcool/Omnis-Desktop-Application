ing-right: 0 !important\" colspan=\"6\" class=\"text-left px-0\">\n              <h1 class=\"text-3xl font-bold text-black my-0 p-0\">Monthly Fleetrack Report (Customer)</h1>\n              <!-- <h2 class=\"text-xl text-ft-red font-bold my-0 p-0\">{{ doc.customer }}</h1> -->\n              <h2 class=\"text-xl font-bold text-black my-0 p-0\">\n                {{ doc.get_formatted(\"date_from\", doc) }} - {{ doc.get_formatted(\"date_to\", doc) }}\n              </h2>\n            </th>\n          </tr>\n\n          <tr>\n            <td class=\"text-black text-nowrap tiny-td-padding text-base font-bold px-2\">Report No: {{ doc.name }}</td>\n\n            <td colspan=\"5\" class=\"text-sm tiny-td-padding px-1 text-xxs\">\n              fleetrack@machinery-exchange.com | https://fleetrack.machinery-exchange.com | +263 784 488 801\n            </td>\n          </tr>\n        </table>\n      </div>\n    </div>\n    <table style=\"border-collapse: separate\">\n      <tr>\n        <th colspan=\"6\" class=\"text-left\" style=\"padding: 0 !important\">\n          <h1 style=\"padding-right: 5px\" class=\"text-xl flex items-center font-bold text-black my-0\">\n            <svg\n              width=\"24px\"\n              height=\"24px\"\n              viewBox=\"0 0 24 24\"\n              stroke-width=\"2\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              color=\"#000000\">\n              <path\n                d=\"M12 12a4 4 0 100-8 4 4 0 000 8z\"\n                stroke=\"#000000\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"></path>\n              <path\n                d=\"M5 20v-1a7 7 0 0110-6.326M21 22l1-6-3.5 1.8L17 16l-1.5 1.8L12 16l1 6h8z\"\n                stroke=\"#000000\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"></path>\n            </svg>\n            <span class=\"pl-2\">{{ doc.customer }}</span>\n          </h1>\n        </th>\n      </tr>\n    </table>\n    <table class=\"text-sm mt-3\">\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Printed by</td>\n        <td style=\"padding: 2px 3px !important\">\n          {{ frappe.db.get_value(\"User\",{\"name\":frappe.session.user}, \"full_name\") }}\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Date</td>\n        <td style=\"padding: 2px 3px !important\">{{ frappe.utils.today() }}</td>\n      </tr>\n    </table>\n\n    <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n      <thead>\n        <tr>\n          <th\n            class=\"bg-ft-red text-lg tiny-th-padding border border-ft-red text-white uppercase font-bold text-center\"\n            colspan=\"10\">\n            Productivity\n          </th>\n        </tr>\n        <tr>\n          <td style=\"padding: 1px !important\" colspan=\"10\"></td>\n        </tr>\n      </thead>\n\n      <tbody>\n        <tr>\n          <th\n            style=\"padding: 2px 5px !important\"\n            colspan=\"1\"\n            class=\"tiny-td-padding border border-mxg-alt bg-mxg-alt text-left\">\n            Machine\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            colspan=\"1\"\n            class=\"tiny-td-padding border border-mxg-alt bg-mxg-alt text-right\">\n            Engine HRS\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            colspan=\"1\"\n            class=\"tiny-td-padding border border-mxg-alt bg-mxg-alt text-right\">\n            Idling HRS\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            colspan=\"1\"\n            class=\"tiny-td-padding border border-mxg-alt bg-mxg-alt text-right\">\n            BD HRS\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            colspan=\"1\"\n            class=\"tiny-td-padding border border-mxg-alt bg-mxg-alt text-right\">\n            Shift Dur.\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            colspan=\"1\"\n            class=\"tiny-td-padding border border-mxg-alt bg-mxg-alt text-right\">\n            Avail. (%)\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            colspan=\"1\"\n            class=\"tiny-td-padding border border-mxg-alt bg-mxg-alt text-right\">\n            Utils. (%)\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            colspan=\"1\"\n            class=\"tiny-td-padding border border-mxg-alt bg-mxg-alt text-right\">\n            Idling (%)\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            colspan=\"1\"\n            class=\"tiny-td-padding border border-mxg-alt bg-mxg-alt text-right\">\n            Loads\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            colspan=\"1\"\n            class=\"tiny-td-padding border border-mxg-alt bg-mxg-alt text-right\">\n            Tons\n          </th>\n        </tr>\n\n        {% for machine in doc.machines %}\n        <tr>\n          <td style=\"padding: 2px 5px !important\" colspan=\"1\" class=\"tiny-td-padding text-left\">\n            <b>{{ machine.model }}</b>\n            <br />\n            {{ machine.type }} ({{ machine.machine }})\n            <br />\n            <b>Ref:</b>\n            {{ frappe.db.get_value(\"FT Machine\", machine.machine, \"fleet_no\")|default(\"-\", True) }}\n          </td>\n          <td style=\"padding: 2px 5px !important\" colspan=\"1\" class=\"tiny-td-padding text-right\">\n            {{ machine.get_formatted(\"engine_hrs\", machine) }}\n          </td>\n          <td style=\"padding: 2px 5px !important\" colspan=\"1\" class=\"tiny-td-padding text-right\">\n            {{ machine.get_formatted(\"idling_hrs\", machine) }}\n          </td>\n          <td style=\"padding: 2px 5px !important\" colspan=\"1\" class=\"tiny-td-padding text-right\">\n            {{ machine.get_formatted(\"bd_hrs\", machine) }}\n          </td>\n          <td style=\"padding: 2px 5px !important\" colspan=\"1\" class=\"tiny-td-padding text-right\">\n            {{ machine.get_formatted(\"shift_dur\", machine) }}\n          </td>\n          <td style=\"padding: 2px 5px !important\" colspan=\"1\" class=\"tiny-td-padding text-right\">\n            {{ machine.get_formatted(\"percentage_available\", machine) }}%\n          </td>\n          <td style=\"padding: 2px 5px !important\" colspan=\"1\" class=\"tiny-td-padding text-right\">\n            {{ machine.get_formatted(\"percentage_utilisation\", machine) }}%\n          </td>\n          <td style=\"padding: 2px 5px !important\" colspan=\"1\" class=\"tiny-td-padding text-right\">\n            {{ machine.get_formatted(\"percentage_idling\", machine) }}%\n          </td>\n          <td style=\"padding: 2px 5px !important\" colspan=\"1\" class=\"tiny-td-padding text-right\">\n            {{ machine.loads }}\n          </td>\n          <td style=\"padding: 2px 5px !important\" colspan=\"1\" class=\"tiny-td-padding text-right\">\n            {{ machine.tonnes }}\n          </td>\n        </tr>\n        {% endfor %}\n        <tr>\n          <td style=\"padding: 1px !important\" colspan=\"10\"></td>\n        </tr>\n      </tbody>\n    </table>\n\n    <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n      <thead>\n        <tr>\n          <th\n            class=\"tiny-th-padding bg-ft-red border text-lg border-ft-red text-white uppercase font-bold text-left\"\n            colspan=\"4\">\n            Maintenance Status\n          </th>\n          <th\n            class=\"tiny-th-padding bg-white border text-lg border-white text-white uppercase font-bold left\"\n            colspan=\"\">\n            ROW/BREAK\n          </th>\n\n          <th\n            class=\"tiny-th-padding bg-ft-red border text-lg border-ft-red text-white uppercase font-bold text-right\"\n            colspan=\"3\">\n            Fuel Management\n          </th>\n        </tr>\n        <tr>\n          <td style=\"padding: 1px !important\" colspan=\"7\"></td>\n        </tr>\n        <tr>\n          <th class=\"bg-mxg-alt text-sm tiny-th-padding\">Machine</th>\n          <th class=\"bg-mxg-alt text-sm tiny-th-padding text-right\">Current Hrs</th>\n          <th class=\"bg-mxg-alt text-sm tiny-th-padding text-right\">Hrs To Service</th>\n          <th class=\"bg-mxg-alt text-sm tiny-th-padding text-left\">State</th>\n          <th class=\"bg-mxg-alt text-sm tiny-th-padding text-left\"></th>\n          <th class=\"bg-mxg-alt text-sm tiny-th-padding text-right\">Avg. Fuel Cons. (L/Hr)</th>\n          <th class=\"bg-mxg-alt text-sm tiny-th-padding text-right\">STD (L/Hr)</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% for machine in doc.machines %}\n        <tr>\n          <td class=\"tiny-td-padding text-left\">\n            <b>{{ machine.model }}</b>\n            <br />\n            {{ machine.type }} ({{ machine.machine }})\n            <br />\n            <b>Ref:</b>\n            {{ frappe.db.get_value(\"FT Machine\", machine.machine, \"fleet_no\")|default(\"-\", True) }}\n          </td>\n          <td class=\"tiny-td-padding text-right\">{{ machine.get_formatted(\"current_hmr\", machine) }}</td>\n          <td class=\"tiny-td-padding text-right\">{{ machine.get_formatted(\"hrs_to_service\", machine) }}</td>\n          <td class=\"tiny-td-padding font-bold text-left\">{{ machine.get_formatted(\"state\", machine) }}</td>\n          <td class=\"tiny-td-padding font-bold text-left\"></td>\n          <td class=\"border-right tiny-td-padding text-right\">\n            {{ machine.get_formatted(\"average_fuel_consumption\") }}\n          </td>\n          <td class=\"tiny-td-padding text-right\">{{ machine.get_formatted(\"std_fuel_consumption\", machine) }}</td>\n        </tr>\n        {% endfor %}\n      </tbody>\n    </table>\n\n    <div class=\"w-full flex\">\n      <div class=\"flex-1\">\n        <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n          <thead>\n            <tr>\n              <th\n                colspan=\"2\"\n                class=\"bg-ft-red tiny-th-padding border text-lg border-ft-red text-white uppercase font-bold text-left\">\n                Messages and Alerts\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            {% if doc.messages|length == 0 %}\n            <tr>\n              <td style=\"padding: 3px !important\" class=\"tiny-td-padding text-sm text-center\" colspan=\"2\">\n                No messages or alerts\n              </td>\n            </tr>\n            {% endif %}\n            {% for message in doc.messages %}\n            <tr>\n              <td style=\"padding: 3px !important\" class=\"tiny-td-padding text-sm\">\n                {% if message.type == \"Message\" %}\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  width=\"16\"\n                  height=\"16\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  class=\"lucide lucide-info\">\n                  <circle cx=\"12\" cy=\"12\" r=\"10\" />\n                  <path d=\"M12 16v-4\" />\n                  <path d=\"M12 8h.01\" />\n                </svg>\n                {% else %}\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  width=\"16\"\n                  height=\"16\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  class=\"lucide lucide-alert-triangle\">\n                  <path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\" />\n                  <path d=\"M12 9v4\" />\n                  <path d=\"M12 17h.01\" />\n                </svg>\n                {% endif %}\n                <b>{{ frappe.db.get_value(\"FT Machine\", message.machine, \"model\") }}</b>\n                <br />\n                {{ frappe.db.get_value(\"FT Machine\", message.machine, \"type\") }} (\n                <b>Ref:</b>\n                {{ frappe.db.get_value(\"FT Machine\", message.machine, \"fleet_no\")|default(\"-\", True) }})\n              </td>\n\n              <td style=\"padding: 1px 2px !important\" class=\"tiny-td-padding text-sm\">{{ message.description }}</td>\n            </tr>\n            {% endfor %}\n          </tbody>\n        </table>\n      </div>\n      <div class=\"flex-1\">\n        <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n          <thead>\n            <tr>\n              <th\n                colspan=\"2\"\n                class=\"bg-ft-red tiny-th-padding border text-lg border-ft-red text-white uppercase font-bold text-left\">\n                Active Defects\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            {% if doc.active_defects|length == 0 %}\n            <tr>\n              <td style=\"padding: 3px !important\" class=\"tiny-td-padding text-sm text-center\" colspan=\"2\">\n                No active defects\n              </td>\n            </tr>\n            {% endif %}\n            {% for defect in doc.active_defects %}\n            <tr>\n              <td class=\"tiny-td-padding\">\n                <b>{{ frappe.db.get_value(\"FT Machine\", defect.machine, \"model\") }}</b>\n                <br />\n                {{ frappe.db.get_value(\"FT Machine\", defect.machine, \"type\") }} (\n                <b>Ref:</b>\n                {{ frappe.db.get_value(\"FT Machine\", defect.machine, \"fleet_no\")|default(\"-\", True) }})\n              </td>\n              <td class=\"tiny-td-padding tex-sm\">\n                {{ defect.description }}\n                <br />\n                <span class=\"text-xs\">\n                  TED:\n                  <span>\n                    {{ frappe.db.get_value(\"FT Defects Log\", defect.defect_reference, \"ted\")|default(\"-\", False) }}\n                  </span>\n                </span>\n              </td>\n            </tr>\n            {% endfor %}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </body>\n</html>\n",
