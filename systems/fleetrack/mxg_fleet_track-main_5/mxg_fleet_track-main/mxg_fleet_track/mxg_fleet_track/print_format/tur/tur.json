ss=\"tiny-td-padding border border-black px-1 text-xs font-bold text-nowrap\">\n            {{ machine.esn }}\n          </td>\n        </tr>\n        <tr>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 py-0 text-xs font-bold text-nowrap\">\n            Current HMR\n          </td>\n          <td class=\"px-2 border tiny-td-padding border-black uppercase text-xs font-bold text-nowrap\">\n            {{ machine.current_hmr }}\n          </td>\n          <td class=\"bg-ft-red tiny-td-padding border border-ft-red px-2 text-xs font-bold text-nowrap\">\n            Total Running Hours\n          </td>\n          <td colspan=\"3\" class=\"tiny-td-padding border border-black px-1 text-xs font-bold text-nowrap\">\n            {{ machine.total_running_hours }}\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding: 0 !important\" colspan=\"6\" class=\"text-sm px-1 text-xxs text-right\">\n            fleetrack@machinery-exchange.com | https://fleetrack.machinery-exchange.com | +263 784 488 801\n          </td>\n        </tr>\n      </table>\n    </div>\n    <table style=\"border-collapse: separate\">\n      <tr>\n        <th colspan=\"6\" class=\"text-left\" style=\"padding: 0 !important\">\n          <h1 style=\"padding-right: 5px\" class=\"text-xl flex items-center font-bold text-black my-0\">\n            <svg\n              width=\"24px\"\n              height=\"24px\"\n              viewBox=\"0 0 24 24\"\n              stroke-width=\"2\"\n              fill=\"none\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n              color=\"#000000\">\n              <path\n                d=\"M12 12a4 4 0 100-8 4 4 0 000 8z\"\n                stroke=\"#000000\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"></path>\n              <path\n                d=\"M5 20v-1a7 7 0 0110-6.326M21 22l1-6-3.5 1.8L17 16l-1.5 1.8L12 16l1 6h8z\"\n                stroke=\"#000000\"\n                stroke-width=\"2\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"></path>\n            </svg>\n            <span class=\"pl-2\">{{ doc.customer }}</span>\n          </h1>\n        </th>\n      </tr>\n    </table>\n    <table class=\"text-sm mt-3\">\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Printed by</td>\n        <td style=\"padding: 2px 3px !important\">\n          {{ frappe.db.get_value(\"User\",{\"name\":frappe.session.user}, \"full_name\") }}\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Date</td>\n        <td style=\"padding: 2px 3px !important\">{{ frappe.utils.today() }}</td>\n      </tr>\n    </table>\n\n    <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n      <thead>\n        <tr>\n          <th class=\"bg-ft-red border text-2xl border-ft-red text-white uppercase font-bold text-center\" colspan=\"8\">\n            Report Details\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td style=\"padding: 2px 5px !important\" colspan=\"4\" class=\"tiny-td-padding\"></td>\n        </tr>\n        <tr>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-mxg-alt border border-mxg-alt text-white\">\n            Inspected by\n          </th>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding text-center border border-mxg-alt\">\n            {{ doc.inspected_by }}\n          </td>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-mxg-alt border border-mxg-alt text-white\">\n            Operator's name\n          </th>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding border text-center border-mxg-alt\">\n            {{ doc.operator_name }}\n          </td>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-mxg-alt border border-mxg-alt text-white\">\n            Date of Inspection\n          </th>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding border text-center border-mxg-alt\">\n            {{ doc.date_of_inspection }}\n          </td>\n          <th style=\"padding: 2px 5px !important\" class=\"tiny-th-padding bg-mxg-alt border border-mxg-alt text-white\">\n            Site\n          </th>\n          <td style=\"padding: 2px 5px !important\" class=\"tiny-td-padding border text-center border-mxg-alt\">\n            {{ doc.site }}\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding: 2px 5px !important\" colspan=\"4\" class=\"tiny-td-padding\"></td>\n        </tr>\n      </tbody>\n    </table>\n\n    <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n      <thead>\n        <tr>\n          <th class=\"bg-ft-red border text-lg border-ft-red text-white uppercase font-bold text-center\" colspan=\"6\">\n            Wear Assessment\n          </th>\n        </tr>\n        <tr>\n          <td class=\"tiny-td-padding\" colspan=\"6\"></td>\n        </tr>\n        <tr>\n          <th class=\"bg-ft-red text-sm tiny-th-padding\">Track Component</th>\n          <th class=\"bg-ft-red text-sm tiny-th-padding text-center\">New (mm)</th>\n          <th style=\"width: 15%\" colspan=\"2\" class=\"bg-ft-red text-sm tiny-th-padding text-center\">Measured (mm)</th>\n          <th style=\"width: 15%\" colspan=\"2\" class=\"bg-ft-red text-sm tiny-th-padding text-center\">% Worn</th>\n        </tr>\n        <tr>\n          <th class=\"text-sm tiny-th-padding border-right border-ft-red\"></th>\n          <th class=\"text-sm tiny-th-padding\"></th>\n          <th colspan=\"1\" class=\"font-bold text-sm tiny-th-padding text-center\">Left</th>\n          <th colspan=\"1\" class=\"font-bold text-sm tiny-th-padding text-center\">Right</th>\n          <th colspan=\"1\" class=\"font-bold text-sm tiny-th-padding text-center\">Left</th>\n          <th colspan=\"1\" class=\"font-bold text-sm tiny-th-padding text-center\">Right</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% for item in doc.components %}\n        <tr>\n          <td class=\"border-right tiny-td-padding border-ft-red\">{{ item.track_component }}</td>\n          <td class=\"tiny-td-padding text-center\">\n            {{ item.get_formatted(\"new_mm\", item) }}\n            <small>mm</small>\n          </td>\n          <td class=\"tiny-td-padding text-center\">\n            {{ item.get_formatted(\"measured_left\", item) }}\n            <small>mm</small>\n          </td>\n          <td class=\"tiny-td-padding text-center\">\n            {{ item.get_formatted(\"measured_right\", item) }}\n            <small>mm</small>\n          </td>\n          <td class=\"tiny-td-padding font-bold text-center\">\n            {{ item.get_formatted(\"percentage_worn_left\", item) }}\n            <small>%</small>\n          </td>\n          <td class=\"tiny-td-padding font-bold text-center\">\n            {{ item.get_formatted(\"percentage_worn_right\", item) }}\n            <small>%</small>\n          </td>\n        </tr>\n        {% endfor %}\n      </tbody>\n      <tfoot>\n        <tr>\n          <td colspan=\"6\" class=\"tiny-td-padding border-bottom border-4 border-ft-red\"></td>\n        </tr>\n        <tr>\n          <td colspan=\"6\" class=\"tiny-td-padding\">&nbsp;</td>\n        </tr>\n        <tr>\n          <th colspan=\"2\" class=\"tiny-td-padding bg-ft-red border-right border-white border-4\">Sprokets</th>\n          <th colspan=\"4\" class=\"tiny-td-padding bg-ft-red border-right border-white border-4\">\n            Other Track Information\n          </th>\n        </tr>\n        <tr>\n          <th colspan=\"1\" class=\"tiny-td-padding bg-mxg-alt border-right border-white border-4\">LHS Condition</th>\n          <td colspan=\"1\" class=\"tiny-td-padding border-right border-white border-4\">\n           