          \"full_name\") }}\n        </td>\n      </tr>\n      <tr>\n        <td style=\"padding: 2px 3px !important\" class=\"text-right\">Date</td>\n        <td style=\"padding: 2px 3px !important\">{{ frappe.utils.today() }}</td>\n      </tr>\n    </table>\n\n    <table style=\"border-collapse: collapse !important\" class=\"w-full\">\n      <thead>\n        <tr>\n          <th\n            class=\"bg-ft-red text-nowrap border border-ft-red text-white uppercase font-bold text-left\"\n          >\n            Technician\n          </th>\n          <th\n            class=\"bg-ft-red border border-ft-red text-white uppercase font-bold text-center\"\n          >\n            Productive Hours\n          </th>\n          <th\n            class=\"bg-ft-red border border-ft-red text-white uppercase font-bold text-center\"\n          >\n            Travel Hours\n          </th>\n          <th\n            class=\"bg-ft-red border border-ft-red text-white uppercase font-bold text-center\"\n          >\n            Admin Hours\n          </th>\n          <th\n            class=\"bg-ft-red border border-ft-red text-white uppercase font-bold text-center\"\n          >\n            House Keeping\n          </th>\n          <th\n            class=\"bg-ft-red border border-ft-red text-white uppercase font-bold text-center\"\n          >\n            Non Productive\n          </th>\n          <th\n            class=\"bg-ft-red border border-ft-red text-white uppercase font-bold text-center\"\n          >\n            Total Non-Billable\n          </th>\n          <th\n            class=\"bg-ft-red border border-ft-red text-white uppercase font-bold text-center\"\n          >\n            Total Billable\n          </th>\n          <th\n            class=\"bg-ft-red border border-ft-red text-white uppercase font-bold text-center\"\n          >\n            Billed\n          </th>\n          <th\n            class=\"bg-ft-red border border-ft-red text-white uppercase font-bold text-center\"\n          >\n            Efficiency %\n          </th>\n        </tr>\n      </thead>\n      <tbody>\n        {% for row in doc.schedule %}\n        <tr>\n          <td class=\"tiny-td-padding text-nowrap\">\n            <b>{{ row.technician }}</b> <br />\n            <b>{{ row.site|default(\"No Site\", True) }}</b> -\n            <i\n              >{{ row.designation|default(\"No Designation Specified\", True)\n              }}</i\n            >\n          </td>\n          <td class=\"tiny-td-padding text-center\">{{ row.productive }}</td>\n          <td class=\"tiny-td-padding text-center\">{{ row.travel }}</td>\n          <td class=\"tiny-td-padding text-center\">{{ row.admin }}</td>\n          <td class=\"tiny-td-padding text-center\">{{ row.house_keeping }}</td>\n          <td class=\"tiny-td-padding text-center\">{{ row.non_productive }}</td>\n          <td class=\"tiny-td-padding text-center\">\n            {{ row.total_non_billable }}\n          </td>\n          <td class=\"tiny-td-padding text-center\">{{ row.total_billable }}</td>\n          <td class=\"tiny-td-padding text-center\">{{ row.billed }}</td>\n          <td class=\"tiny-td-padding text-center\">\n            {{ row.get_formatted(\"efficiency\", row) }}\n          </td>\n        </tr>\n        {% endfor %}\n      </tbody>\n    </table>\n\n    <!-- Signatures -->\n    <table class=\"w-full mt-4\">\n      <thead>\n        <tr>\n          <th\n            style=\"padding: 2px 5px !important\"\n            class=\"text-center border border-ft-red bg-ft-red text-white\"\n          >\n            Fleetrack\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            class=\"text-center border border-ft-red bg-ft-red text-white\"\n          >\n            Customer Service Coordinator\n          </th>\n          <th\n            style=\"padding: 2px 5px !important\"\n            class=\"text-center border border-ft-red bg-ft-red text-white\"\n          >\n    