      <div class="um-card" style="display:flex;align-items:center;gap:16px;">
        <div style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#10b981,#059669);display:flex;align-items:center;justify-content:center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div>
          <div style="font-size:14px;font-weight:600;color:#1e293b;">Supabase Auth</div>
          <div style="font-size:12px;color:#10b981;">G�� Connected</div>
        </div>
      </div>
      <div class="um-card" style="display:flex;align-items:center;gap:16px;">
        <div style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#f59e0b,#d97706);display:flex;align-items:center;justify-content:center;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
        </div>
        <div>
          <div style="font-size:14px;font-weight:600;color:#1e293b;">Admin Account</div>
          <div style="font-size:11px;color:#94a3b8;word-break:break-all;">takunda@industrial-exchange.group</div>
        </div>
      </div>
    </div>

    <!-- Users table card -->
    <div class="um-card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:12px;">
        <div>
          <div style="font-size:16px;font-weight:700;color:#1e293b;">User Accounts</div>
          <div style="font-size:12px;color:#94a3b8;margin-top:2px;">Manage login access to Fleetrack</div>
        </div>
        <div style="display:flex;gap:10px;align-items:center;">
          <div style="position:relative;">
            <input type="text" class="um-search" placeholder="Search usersGǪ" oninput="filterUserTable(this.value)" style="width:220px;" />
          </div>
          <button class="um-btn um-btn-primary" onclick="openUserMgmtModal()" style="padding:9px 16px;font-size:12px;border-radius:8px;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;border:none;cursor:pointer;font-weight:600;display:flex;align-items:center;gap:6px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New User
          </button>
          <button onclick="loadUserMgmt()" style="padding:9px 12px;background:#f1f5f9;border:none;border-radius:8px;cursor:pointer;color:#64748b;font-size:12px;font-weight:600;">G�+ Refresh</button>
        </div>
      </div>

      <div style="overflow-x:auto;">
        <table class="um-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Email Status</th>
              <th>Account Status</th>
              <th>Last Sign In</th>
              <th>Actions</th>
